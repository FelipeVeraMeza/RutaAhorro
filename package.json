{
  "name": "rutaahorro",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestión de inventario, ventas y caja para comercios pequeños y medianos",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@rutaahorro/web",
    "dev:web": "npm run dev --workspace=@rutaahorro/web",
    "dev:worker": "npm run dev --workspace=@rutaahorro/worker",
    "build": "npm run build -w @rutaahorro/core && npm run build -w @rutaahorro/worker",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:check": "node tools/sql-check/parse.js && node tools/sql-check/plpgsql.js",
    "db:test": "node --test --test-concurrency=1 --test-timeout=60000 \"tools/pg-test/*.test.mjs\"",
    "db:bundle": "node tools/sql-check/bundle.js",
    "db:instalar": "node tools/sql-check/instalar.js",
    "db:admin": "node tools/crear-admin.mjs",
    "db:aplicar": "node tools/aplicar-esquema.mjs",
    "db:limpiar": "node tools/limpiar-base.mjs",
    "db:e2e": "node tools/venta-real.mjs",
    "build:web": "npm run build -w @rutaahorro/core && npm run build -w @rutaahorro/web"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.0",
    "pg-query-emscripten": "^5.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2"
  }
}

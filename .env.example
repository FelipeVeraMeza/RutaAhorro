# ============================================================================
# RutaAhorro — Plantilla de variables de entorno
# ----------------------------------------------------------------------------
# Copiar como .env.local (frontend) / .env (worker) y rellenar con valores
# reales. NUNCA comitear el archivo con valores reales.
# ============================================================================

# --- Supabase: seguro de exponer en el navegador ---------------------------
# Estas dos viajan al cliente. Su seguridad depende 100% de que RLS esté
# habilitado en TODAS las tablas.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# --- Supabase: SECRETO. Solo servidor (Railway worker / route handlers) -----
# Ignora RLS por completo. Si se filtra, se compromete toda la base de datos.
# No debe existir con prefijo NEXT_PUBLIC_ bajo ninguna circunstancia.
SUPABASE_SERVICE_ROLE_KEY=<service_role key — SOLO backend>

# --- Conexión directa a Postgres (worker: respaldos con pg_dump) -----------
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# --- Aplicación ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development            # development | staging | production
TZ=America/Santiago

# --- Worker (Railway) ------------------------------------------------------
WORKER_PORT=8080
# Secreto compartido para que el frontend pueda invocar al worker
WORKER_SHARED_SECRET=<generar con: openssl rand -hex 32>

# --- Respaldos -------------------------------------------------------------
BACKUP_BUCKET=respaldos
BACKUP_RETENTION_DAYS=30

# --- Notificaciones (alertas de stock, cierre de caja) ---------------------
# Proveedor por definir — ver docs/15-preguntas-abiertas.md
RESEND_API_KEY=
ALERTS_EMAIL_TO=

# --- Observabilidad (opcional, recomendado) --------------------------------
SENTRY_DSN=
